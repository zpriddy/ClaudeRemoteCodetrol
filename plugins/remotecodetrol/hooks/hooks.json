{
  "description": "Hooks for the RemoteCodetrol plugin: inject pending replies as additionalContext, and install the rcct CLI symlink on session start.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/install-rcct.sh\""
          }
        ]
      }
    ]
  }
}
